+	struct request_queue *q = m->private;				\
+	struct ssg_data *ssg = q->elevator->elevator_data;		\
+									\
+	return seq_list_next(v, &ssg->fifo_list[ddir], pos);		\
+}									\
+									\
+static void ssg_##name##_fifo_stop(struct seq_file *m, void *v)	\
+	__releases(&ssg->lock)						\
+{									\
+	struct request_queue *q = m->private;				\
+	struct ssg_data *ssg = q->elevator->elevator_data;		\
+									\
+	spin_unlock(&ssg->lock);					\
+}									\
