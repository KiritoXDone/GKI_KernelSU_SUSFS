+					  loff_t *pos)			\
+	__acquires(&ssg->lock)						\
+{									\
+	struct request_queue *q = m->private;				\
+	struct ssg_data *ssg = q->elevator->elevator_data;		\
+									\
+	spin_lock(&ssg->lock);						\
+	return seq_list_start(&ssg->fifo_list[ddir], *pos);		\
