new file mode 100644
index 0000000000000000000000000000000000000000..383fc3437f02e0dbb14a4012eea65a59cc111df6
--- /dev/null
+++ b/fs/ntfs3/record.c
@@ -0,0 +1,618 @@
+// SPDX-License-Identifier: GPL-2.0
